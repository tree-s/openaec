{
    "version": "2026.44.4",
    "description": "Free, open-source PDF editor and annotator",
    "homepage": "https://github.com/OpenAEC-Foundation/open-pdf-studio",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenAEC-Foundation/open-pdf-studio/releases/download/v2026.44.4/Open.PDF.Studio_2026.44.4_x64-setup.exe",
            "hash": "74bde52cf33772b5aef7b1a13ac1f7c285198b3348e4ed899aae0e6652230554"
        }
    },
    "installer": {
        "script": [
            "$installer = \"$dir\\Open.PDF.Studio_$version`_x64-setup.exe\"",
            "Start-Process $installer -ArgumentList \"/S /D=$dir\" -Wait",
            "Remove-Item $installer -Force"
        ]
    },
    "uninstaller": {
        "script": [
            "$uninstaller = \"$dir\\uninstall.exe\"",
            "if (Test-Path $uninstaller) {",
            "    Start-Process $uninstaller -ArgumentList '/S' -Wait",
            "}"
        ]
    },
    "shortcuts": [
        [
            "open-pdf-studio.exe",
            "Open PDF Studio"
        ]
    ],
    "checkver": {
        "github": "https://github.com/OpenAEC-Foundation/open-pdf-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenAEC-Foundation/open-pdf-studio/releases/download/v$version/Open.PDF.Studio_$version_x64-setup.exe"
            }
        }
    }
}
