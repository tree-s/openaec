{
    "version": "2.3.0",
    "description": "Free, open-source PDF editor and annotator",
    "homepage": "https://github.com/OpenAEC-Foundation/open-pdf-studio",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenAEC-Foundation/open-pdf-studio/releases/download/v2.3.0/Open.PDF.Studio_2.3.0_x64_user-setup.exe",
            "hash": "b5c6ad6c49f792a1ef1cfa0be9a81b40bccf088a215ef428e8540074a5e80a32"
        }
    },
    "installer": {
        "script": [
            "Start-Process \"$dir\\Open.PDF.Studio_2.3.0_x64_user-setup.exe\" -ArgumentList '/S' -Wait"
        ]
    },
    "uninstaller": {
        "script": [
            "Get-ChildItem \"$env:LOCALAPPDATA\\Programs\" -Filter '*Open*PDF*Studio*' -Directory | ForEach-Object {",
            "    $uninstaller = Join-Path $_.FullName 'Uninstall Open PDF Studio.exe'",
            "    if (Test-Path $uninstaller) { Start-Process $uninstaller -ArgumentList '/S' -Wait }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/OpenAEC-Foundation/open-pdf-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenAEC-Foundation/open-pdf-studio/releases/download/v$version/Open.PDF.Studio_$version_x64_user-setup.exe"
            }
        }
    }
}
